# =============================================================================
# Coinbase Trading Bot - Environment Configuration
# =============================================================================
# WARNING: Never commit your actual .env file to version control.
# WARNING: Never share your API key or secret with anyone.
# WARNING: Add .env to your .gitignore immediately.
# =============================================================================

# Coinbase Advanced Trade API credentials
# Generate these at: https://www.coinbase.com/settings/api
# Required permissions: "View" for read-only, "Trade" for order placement
COINBASE_API_KEY=your_api_key_here
COINBASE_API_SECRET=your_api_secret_here

# Optional: Coinbase portfolio UUID (leave blank to use default portfolio)
COINBASE_PORTFOLIO_ID=

# Trading mode safety toggles
# ENABLE_REAL_TRADING must be explicitly set to "true" to allow real orders.
# PAPER_TRADING must be explicitly set to "false" to disable paper mode.
# Both flags must agree for real trading to activate.
ENABLE_REAL_TRADING=false
PAPER_TRADING=true

# Paper trading starting balance (USD)
PAPER_STARTING_BALANCE=10000

# Risk parameters
RISK_PER_TRADE_PCT=1.0
MIN_RISK_REWARD=2.0
CONFIDENCE_THRESHOLD=65
MAX_NOTIONAL_PER_TRADE=5000
DAILY_LOSS_LIMIT_PCT=5.0
COOLDOWN_AFTER_STOP_LOSS_SECONDS=300

# Trading pairs (comma-separated)
TRADING_PAIRS=BTC-USD,ETH-USD,SOL-USD

# Bot cycle interval in seconds
CYCLE_INTERVAL_SECONDS=60

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
