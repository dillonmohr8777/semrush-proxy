# ── Coinbase Advanced Trade API ──────────────────────────────
# Get from: https://www.coinbase.com/settings/api
# Permissions needed: view, trade
COINBASE_API_KEY=your_api_key_here
COINBASE_API_SECRET=your_api_secret_here

# ── Sandbox Mode (optional) ───────────────────────────────────
# To use the Coinbase Exchange sandbox, set these two lines
# and use sandbox API keys from: https://public.sandbox.exchange.coinbase.com
# Comment out or remove for production
# COINBASE_REST_URL=https://api-public.sandbox.exchange.coinbase.com
# COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com

# ── Telegram Alerts (optional) ───────────────────────────────
# Create bot: https://t.me/BotFather → /newbot
# Get chat ID: send a message to your bot, then call:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Mode ─────────────────────────────────────────────────────
# "paper" = simulation only (default)
# "live"  = real trades (requires API keys)
TRADING_MODE=paper

# ── Capital ──────────────────────────────────────────────────
STARTING_CAPITAL=500.0
MAX_TOTAL_CAPITAL=17000.0

# ── Risk ─────────────────────────────────────────────────────
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.06
DAILY_LOSS_LIMIT=150.0
MAX_OPEN_POSITIONS=4
MAX_TRADE_USD=200.0

# ── Strategy ─────────────────────────────────────────────────
CANDLE_GRANULARITY=ONE_HOUR
ENSEMBLE_MIN_VOTES=2
POLL_INTERVAL_SEC=60
