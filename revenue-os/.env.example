# Revenue OS - Environment Configuration
# Copy this to .env and fill in your values

# ============================================
# HUBSPOT CONFIGURATION
# ============================================
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token
HUBSPOT_PORTAL_ID=your_portal_id

# ============================================
# OBSIDIAN VAULT PATH
# ============================================
# Absolute path to the Revenue OS Obsidian vault
# This must be a SEPARATE vault from any personal vaults
VAULT_PATH=/path/to/Revenue-OS-Vault

# ============================================
# EMAIL NOTIFICATIONS (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
NOTIFICATION_EMAIL_TO=vp_sales@company.com
NOTIFICATION_EMAIL_FROM=revenue-os@company.com

# ============================================
# CLAUDE API (for agent intelligence)
# ============================================
ANTHROPIC_API_KEY=your_anthropic_api_key

# ============================================
# ALERT THRESHOLDS
# ============================================
# Days without activity before flagging a deal
STALE_DEAL_DAYS=7
# Minimum pipeline coverage ratio (e.g., 3.0 = 3x coverage)
MIN_PIPELINE_COVERAGE=3.0
# Activity score threshold for rep coaching alerts
REP_ACTIVITY_THRESHOLD=50
# Forecast confidence drop percentage to trigger drift alert
FORECAST_DRIFT_THRESHOLD=10

# ============================================
# SCHEDULE (CRON FORMAT)
# ============================================
DAILY_BRIEF_CRON=0 7 * * 1-5
WEEKLY_FORECAST_CRON=0 8 * * 1
PIPELINE_SYNC_CRON=0 */4 * * *
